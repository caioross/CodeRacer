# .env.example — Template seguro de variáveis de ambiente
# Copie este arquivo para .env.local (nunca .env na raiz sem .local para projetos Next.js)
# NUNCA preencha valores reais aqui — este arquivo É commitado.
# Os valores reais ficam em .env.local (ignorado pelo .gitignore).

# =============================================================================
# Supabase
# =============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.****

# ATENÇÃO: service_role NUNCA vai para o cliente (NEXT_PUBLIC_*).
# Use apenas em server-side (API routes, Edge Functions, scripts de admin).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.****

# =============================================================================
# Stripe
# =============================================================================
# Chave pública — pode ir para o cliente (NEXT_PUBLIC_)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_****

# Chave secreta — NUNCA no cliente. Somente server-side.
STRIPE_SECRET_KEY=sk_live_****

# Segredo do webhook (gerado no dashboard Stripe → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_****

# =============================================================================
# Google OAuth (formato Next-Auth / NextAuth.js)
# =============================================================================
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-****

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=gere-com-openssl-rand-base64-32

# =============================================================================
# Google Analytics / GA4
# =============================================================================
# Nunca armazene refresh_token de usuário pessoal aqui.
# Use Service Account com escopo de leitura.
GA_PROPERTY_ID=123456789
GA_SERVICE_ACCOUNT_EMAIL=analytics-reader@project.iam.gserviceaccount.com
# Chave da service account: manter fora do repo (GitHub Secrets ou cofre)
# GA_SERVICE_ACCOUNT_KEY_PATH=/run/secrets/ga_service_account.json

# =============================================================================
# Android / AulaLogger (referenciado em build.gradle.kts via System.getenv)
# =============================================================================
# NUNCA preencher aqui — usar GitHub Secrets em CI ou cofre local.
# KEYSTORE_PATH=/path/to/upload.jks
# KEYSTORE_PASSWORD=****
# KEY_ALIAS=upload
# KEY_PASSWORD=****

# =============================================================================
# App
# =============================================================================
NODE_ENV=development
APP_URL=http://localhost:3000
