# ─────────────────────────────────────────────────────────────
# CodeRacer — environment variables
# Copy this file to `.env.local` (and mirror these on Vercel).
# ─────────────────────────────────────────────────────────────

# Supabase powers BOTH the realtime multiplayer (presence + broadcast) and
# persistence (rooms + leaderboard). Grab these from your Supabase project:
# Settings → API (URL + keys) and Settings → Database (connection string).

# --- Client (browser) — used by Supabase Realtime. Safe to expose. ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# --- Server (API routes) — service role bypasses RLS to write rooms/scores. ---
# NEVER expose the service role key in client code or commit it.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Postgres connection string — used by the migration script: `pnpm db:migrate`.
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# Public origin used for SEO (canonical, Open Graph, sitemap, JSON-LD).
# OPTIONAL: on Vercel the app already derives the origin from the deploy itself
# (project production domain, then current deploy). Set this only to override
# that — e.g. when you point a custom domain at the project. It must be the
# origin that actually SERVES the site: a domain that doesn't answer kills the
# link preview of every shared room and hands the SEO to another origin.
# Absolute URL, NO trailing slash. Locally it defaults to http://localhost:3000.
# NEXT_PUBLIC_SITE_URL=https://your-real-domain.example
