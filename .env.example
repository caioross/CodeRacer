# ─────────────────────────────────────────────────────────────
# CodeRacer — environment variables
# Copy this file to `.env.local` and adjust the values.
# ─────────────────────────────────────────────────────────────

# Public origin used for SEO: canonical URLs, Open Graph / Twitter images,
# sitemap.xml, robots.txt and JSON-LD. Absolute URL, NO trailing slash.
# In production set this to your real domain.
NEXT_PUBLIC_SITE_URL=https://coderacer.app

# Port for the custom server (Next.js + Socket.io share the same port).
# Optional — defaults to 3000.
PORT=3000

# ─────────────────────────────────────────────────────────────
# Supabase — persists finished matches and powers the global leaderboard.
# Get these from your Supabase project: Settings → API / Database.
# If left unset, the game still works fully in memory (no leaderboard).
# ─────────────────────────────────────────────────────────────

# Project REST URL.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co

# Service role key — SERVER ONLY. Bypasses RLS to write matches. Never expose
# this in client code or commit it.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Connection string (used by the migration script: pnpm db:migrate).
DATABASE_URL=postgresql://postgres:PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
